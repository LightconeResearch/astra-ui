{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightconeresearch.org/schemas/astra-viewer/graph-organization.v1.json",
  "title": "ASTRA viewer graph organization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "groups"],
  "properties": {
    "schema_version": {
      "const": "graph-organization.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "organization_input_digest"],
      "properties": {
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "organization_input_digest": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "scope", "kind", "members"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["input", "decision", "output", "finding", "prior_insight"]
          },
          "members": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
