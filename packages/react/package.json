{
  "name": "@lightcone-research/astra-ui",
  "version": "0.1.0",
  "description": "Host-neutral React surfaces for inspecting ASTRA project view models.",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./components.css",
    "./views.css",
    "./inventory.css",
    "./graph.css",
    "./ui.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./views": {
      "types": "./dist/views.d.ts",
      "import": "./dist/views.js",
      "default": "./dist/views.js"
    },
    "./styles.css": "./styles.css",
    "./components.css": "./components.css",
    "./views.css": "./views.css",
    "./inventory.css": "./inventory.css",
    "./graph.css": "./graph.css",
    "./ui.css": "./ui.css",
    "./graph-organization.schema.json": "./graph-organization.schema.json"
  },
  "files": [
    "dist",
    "styles.css",
    "components.css",
    "views.css",
    "inventory.css",
    "graph.css",
    "ui.css",
    "graph-organization.schema.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@astra-spec/sdk": "^0.0.5",
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "engines": {
    "node": ">=18"
  }
}
