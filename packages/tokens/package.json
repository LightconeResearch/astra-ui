{
  "name": "@lightcone-research/astra-viewer-tokens",
  "version": "0.1.0",
  "description": "Scoped semantic design tokens and component styles for ASTRA viewers.",
  "license": "BSD-3-Clause",
  "type": "module",
  "sideEffects": [
    "./brand.css",
    "./theme.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./theme.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./brand.css": "./brand.css",
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "brand.css",
    "theme.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
