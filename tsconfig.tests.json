{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "checkJs": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "tests/dom/**/*.ts",
    "tests/dom/**/*.tsx",
    "vitest.config.ts"
  ]
}
